datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum PlanType {
  FREE_TRIAL
  PRO_AGENCY
  ENTERPRISE
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WHATSAPP_BAILEYS
  TIKTOK
  LINKEDIN
  YOUTUBE
  X
  GMAIL
  THREADS
  PINTEREST
  SNAPCHAT
  REDDIT
  TELEGRAM
  GOOGLE_BUSINESS
  MEDIUM
  SMS
  WEB_CHAT
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PostType {
  TEXT
  SINGLE_IMAGE
  CAROUSEL
  VIDEO
  REEL
  STORY
  THREAD
  LINK
}

enum LeadStage {
  NEW_LEAD
  PROSPECT
  QUALIFIED
  CUSTOMER
  CHURNED
}

enum ThreadStatus {
  OPEN
  PENDING
  RESOLVED
  BOT_HANDLED
}

enum SenderType {
  CUSTOMER
  AGENT
  AI_BOT
  SYSTEM
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  CLIENT
}

enum WorkspaceRole {
  ADMIN
  MANAGER
  EDITOR
  APPROVER
  VIEWER
}

enum AIAgentType {
  SOCIAL_POST_CREATOR
  FASHION_STUDIO
  UGC_CAPTION_GENERATOR
  PHOTO_SHOOT_CREATOR
  VIDEO_GENERATOR
  INBOX_SALES_AGENT
  VOICE_CALL_AGENT
  BOOKING_AGENT
  COMMENT_MODERATOR
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  BKASH
  NAGAD
  ROCKET
  UPAY
  MANUAL_BANK
}

enum InvoiceStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

// -----------------------------------------------------------------------------
// 1. TENANCY, USERS & ROLES
// -----------------------------------------------------------------------------

model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique @default(uuid())
  cnameDomain     String?      @unique
  customDomain    String?      @unique
  themeSettings   Json?
  plan            PlanType     @default(FREE_TRIAL)
  aiCredits       Int          @default(5000)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users           User[]
  workspaces      Workspace[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  creditWallet    CreditWallet?
  coupons         Coupon[]
  affiliate       Affiliate?
  apiKeys         ApiKey[]
}

model Workspace {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  storageLimitMb  Int          @default(5120)

  settings        WorkspaceSettings?
  members         WorkspaceMember[]
  socialAccounts  SocialAccount[]
  posts           Post[]
  leads           Lead[]
  contacts        Contact[]
  inboxThreads    InboxThread[]
  campaigns       Campaign[]
  mediaAssets     MediaAsset[]
  shortLinks      ShortLink[]
  emailTemplates  EmailTemplate[]
  forms           Form[]
  aiAgents        AIAgent[]
  auditLogs       AuditLog[]
  webhookEvents   WebhookEvent[]
  biolinks        BiolinkPage[]
  qrCodes         QrCode[]
  crmCustomers    CrmCustomer[]
  crmCustomerGroups CrmCustomerGroup[]
  crmInvoices     CrmInvoice[]
  crmEstimates    CrmEstimate[]
  crmProposals    CrmProposal[]
  crmProjects     CrmProject[]
  crmContracts    CrmContract[]
  crmTickets      CrmTicket[]
  smtpServers     MarketingSmtpServer[]
  // Phase 3 relations
  subscriberLists  SubscriberList[]
  smsProviders     SmsProvider[]
  recurringInvoices RecurringInvoice[]
  expenses         Expense[]
  recurringExpenses RecurringExpense[]
  activityLogs     ActivityLog[]
  crmGoals         CrmGoal[]
  staffTasks       StaffTask[]
  staffReminders   StaffReminder[]
  kbCategories     KbCategory[]
  kbArticles       KbArticle[]
  surveys          Survey[]
  crmWebForms      CrmWebForm[]
  newsfeedPosts    NewsfeedPost[]
  companyEvents    CompanyEvent[]

  @@index([organizationId])
}



model WorkspaceSettings {
  workspaceId      String   @id
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timezone         String   @default("Asia/Dhaka")
  countryCode      String   @default("BD")
  defaultLanguage  String   @default("bn")
  googleCalendarId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  fullName        String
  avatar          String?
  phone           String?
  language        String   @default("en")
  role            Role     @default(ADMIN)
  isSuperAdmin    Boolean  @default(false)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  posts            Post[]
  supportTickets   SupportTicket[] @relation("UserTickets")
  assignedTickets  SupportTicket[] @relation("AssignedTickets")
  affiliate        Affiliate?

  @@index([organizationId])
}


model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(EDITOR)
  permissions Json?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model CreditWallet {
  id              String              @id @default(uuid())
  organizationId  String              @unique
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balance         Int                 @default(5000)
  transactions    CreditTransaction[]
  updatedAt       DateTime            @updatedAt
}

model CreditTransaction {
  id              String        @id @default(uuid())
  walletId        String
  wallet          CreditWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Int
  actionType      String
  description     String
  createdAt       DateTime      @default(now())
}

// -----------------------------------------------------------------------------
// 2. SOCIAL MEDIA ACCOUNTS & POST SCHEDULING
// -----------------------------------------------------------------------------

model SocialAccount {
  id                String         @id @default(uuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  accountName       String
  username          String?
  accountExternalId String
  accessToken       String         @db.Text
  refreshToken      String?        @db.Text
  tokenExpiresAt    DateTime?
  sessionData       Json?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  postTargets       PostTarget[]
  inboxThreads      InboxThread[]
  rssFeeds          RSSFeed[]

  @@unique([workspaceId, platform, accountExternalId])
  @@index([workspaceId])
}

model Post {
  id              String        @id @default(uuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  campaignId      String?
  campaign        Campaign?     @relation(fields: [campaignId], references: [id])

  title           String?
  content         String        @db.Text
  firstComment    String?       @db.Text
  mediaUrls       Json          @default("[]")
  postType        PostType      @default(TEXT)
  targetPlatforms Json          @default("[]")
  status          PostStatus    @default(DRAFT)
  scheduledAt     DateTime?
  timezone        String        @default("UTC")
  googleCalendarEventId String?
  errorLogs       Json?
  publishedAt     DateTime?
  platformOverrides Json?

  media           PostMedia[]
  targets         PostTarget[]
  approvalLogs    PostApprovalLog[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId, status])
  @@index([status, scheduledAt])
}

model PostMedia {
  id          String     @id @default(uuid())
  postId      String
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id])
  sortOrder   Int        @default(0)
}

model PostTarget {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          PostStatus    @default(SCHEDULED)
  externalPostId  String?
  externalPostUrl String?
  errorMessage    String?
  publishedAt     DateTime?
}

model PostApprovalLog {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewerId  String
  action      String
  comment     String?
  createdAt   DateTime @default(now())
}

model RSSFeed {
  id              String        @id @default(uuid())
  workspaceId     String
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  feedUrl         String
  feedName        String
  autoPostTemplate String       @db.Text
  isActive        Boolean       @default(true)
  lastPolledAt    DateTime?
  createdAt       DateTime      @default(now())
}

// -----------------------------------------------------------------------------
// 3. OMNICHANNEL INBOX
// -----------------------------------------------------------------------------

model InboxThread {
  id               String         @id @default(uuid())
  workspaceId      String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId  String?
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id])
  platform         SocialPlatform
  externalThreadId String?
  externalSenderId String
  contactId        String?
  contact          Contact?       @relation(fields: [contactId], references: [id])

  customerName     String?
  customerPhone    String?
  customerEmail    String?
  assignedStaffId  String?
  assignedAgentId  String?
  status           ThreadStatus   @default(OPEN)
  unreadCount      Int            @default(0)
  lastMessageAt    DateTime       @default(now())
  metadata         Json?
  messages         InboxMessage[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workspaceId, platform])
  @@index([workspaceId, lastMessageAt(sort: Desc)])
}

model InboxMessage {
  id          String     @id @default(uuid())
  workspaceId String
  threadId    String
  thread      InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderType  SenderType
  senderId    String?
  messageType String     @default("TEXT")
  body        String?    @db.Text
  mediaUrl    String?
  attachments Json?
  createdAt   DateTime   @default(now())

  @@index([threadId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

// -----------------------------------------------------------------------------
// 4. CRM
// -----------------------------------------------------------------------------

model Contact {
  id              String        @id @default(uuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  avatar          String?
  tags            String[]      @default([])
  customFields    Json?
  stage           LeadStage     @default(NEW_LEAD)
  leadScore       Int           @default(0)

  inboxThreads    InboxThread[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
}

model Lead {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  stage       LeadStage @default(NEW_LEAD)
  score       Int       @default(50)
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, stage])
}

model Form {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  schemaJson  Json
  createdAt   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 5. MARKETING & SHORT LINKS
// -----------------------------------------------------------------------------

model Campaign {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  subject     String?
  body        String         @db.Text
  scheduledAt DateTime?
  sentCount   Int            @default(0)
  posts       Post[]
  shortLinks  ShortLink[]
  events      CampaignEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, status])
}

model EmailTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  htmlBody    String    @db.Text
  designJson  Json?
  createdAt   DateTime  @default(now())
}

model ShortLink {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  originalUrl String    @db.Text
  shortSlug   String    @unique
  clicksCount Int       @default(0)
  analytics   LinkClick[]
  createdAt   DateTime  @default(now())
}

model LinkClick {
  id          String    @id @default(uuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  country     String?
  referrer    String?
  clickedAt   DateTime  @default(now())
}

// -----------------------------------------------------------------------------
// 6. MONETIZATION, BILLING & LOCAL PAYMENT GATEWAYS
// -----------------------------------------------------------------------------

model Plan {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  priceMonthly    Float
  priceYearly     Float
  monthlyCredits  Int
  maxSocialAccounts Int
  maxWorkspaces   Int
  maxTeamMembers  Int
  features        Json
  isPublic        Boolean          @default(true)
  subscriptions   Subscription[]
}

model Subscription {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan           @relation(fields: [planId], references: [id])
  status          SubStatus      @default(ACTIVE)
  billingInterval BillingInterval @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean      @default(false)

  paymentGateway  PaymentGateway
  gatewaySubId    String?
  invoices        Invoice[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  amount          Float
  currency        String        @default("USD")
  gateway         PaymentGateway
  transactionId   String?
  status          InvoiceStatus @default(UNPAID)
  invoicePdfUrl   String?
  createdAt       DateTime      @default(now())
}

model Coupon {
  id              String    @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String    @unique
  discountPercent Float?
  discountAmount  Float?
  maxRedemptions  Int?
  redemptionsCount Int      @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
}

model Affiliate {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  organizationId  String @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralCode    String    @unique
  commissionRate  Float     @default(15.0)
  earningsBalance Float     @default(0.0)
  createdAt       DateTime  @default(now())
}

// -----------------------------------------------------------------------------
// 7. AI AGENTS & MEDIA ASSETS
// -----------------------------------------------------------------------------

model AIAgent {
  id              String      @id @default(uuid())
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  agentType       AIAgentType
  systemPrompt    String      @db.Text
  modelProvider   String      @default("openai")
  modelName       String      @default("gpt-4o")
  temperature     Float       @default(0.7)
  skills          Json?
  isActive        Boolean     @default(true)

  executions      AIExecution[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model AIExecution {
  id              String    @id @default(uuid())
  workspaceId     String
  aiAgentId       String
  aiAgent         AIAgent   @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  prompt          String    @db.Text
  output          Json?
  creditsUsed     Int       @default(0)
  status          String    @default("SUCCESS")
  createdAt       DateTime  @default(now())
}

model MediaAsset {
  id              String      @id @default(uuid())
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId        String?
  folder          Folder?     @relation(fields: [folderId], references: [id])

  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  width           Int?
  height          Int?
  storageKey      String
  storageEngine   String      @default("S3")
  metadata        Json?
  starred         Boolean     @default(false)
  shareSlug       String?     @unique

  postMedia       PostMedia[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([workspaceId])
}

model Folder {
  id              String       @id @default(uuid())
  workspaceId     String
  name            String
  parentId        String?
  parent          Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id])
  subFolders      Folder[]     @relation("FolderHierarchy")
  mediaAssets     MediaAsset[]
  createdAt       DateTime     @default(now())
}

// -----------------------------------------------------------------------------
// 8. SYSTEM & SUPPORT
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([entityType, entityId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      String
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([source])
}

model ApiKey {
  id          String   @id @default(uuid())
  workspaceId String?
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name          String
  keyHash       String   @unique
  lastUsedAt    DateTime?
  revoked       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([organizationId])
}

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  user          User         @relation("UserTickets", fields: [userId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("AssignedTickets", fields: [assignedToId], references: [id])
  subject     String
  category    String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  messages    TicketMessage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  message     String   @db.Text
  attachments Json?
  createdAt   DateTime @default(now())
}

model BiolinkPage {
  id              String         @id @default(uuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  urlSlug         String         @unique
  title           String?
  description     String?
  logoUrl         String?
  themeSettings   Json           @default("{}")
  isActive        Boolean        @default(true)
  viewsCount      Int            @default(0)
  blocks          BiolinkBlock[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workspaceId])
}

model BiolinkBlock {
  id            String      @id @default(uuid())
  biolinkPageId String
  biolinkPage   BiolinkPage @relation(fields: [biolinkPageId], references: [id], onDelete: Cascade)
  type          String
  config        Json
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([biolinkPageId])
}

model QrCode {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        String
  config      Json
  shortSlug   String?   @unique
  scansCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// -----------------------------------------------------------------------------
// CRM MODULE MODELS
// -----------------------------------------------------------------------------

model CrmCustomer {
  id          String               @id @default(uuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyName String
  vatNumber   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  phone       String?
  website     String?
  currency    String               @default("USD")
  language    String?              @default("English")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Shipping Address
  shippingStreet  String?
  shippingCity    String?
  shippingState   String?
  shippingZipCode String?
  shippingCountry String?

  contacts          CrmCustomerContact[]
  groups            CrmCustomerGroupRelation[]
  invoices          CrmInvoice[]
  estimates         CrmEstimate[]
  proposals         CrmProposal[]
  projects          CrmProject[]
  contracts         CrmContract[]
  recurringInvoices RecurringInvoice[]
  expenses          Expense[]

  @@index([workspaceId])
}

model CrmCustomerContact {
  id          String      @id @default(uuid())
  customerId  String
  customer    CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String      @unique
  phone       String?
  password    String?
  permissions Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
}

model CrmCustomerGroup {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())

  customers   CrmCustomerGroupRelation[]

  @@index([workspaceId])
}

model CrmCustomerGroupRelation {
  customerId String
  customer   CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  groupId    String
  group      CrmCustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([customerId, groupId])
}

model CrmInvoice {
  id              String           @id @default(uuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId      String
  customer        CrmCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  status          String           @default("DRAFT")
  issueDate       DateTime
  dueDate         DateTime
  currency        String           @default("USD")
  subtotal        Float
  taxTotal        Float
  total           Float
  isRecurring     Boolean          @default(false)
  recurringPeriod String?
  recurringCycle  Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           CrmInvoiceItem[]

  @@index([workspaceId])
  @@index([customerId])
}

model CrmInvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     CrmInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  rate        Float
  taxPercent  Float      @default(0.0)
  total       Float

  @@index([invoiceId])
}

model CrmEstimate {
  id             String            @id @default(uuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId     String
  customer       CrmCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  estimateNumber String
  status         String            @default("DRAFT")
  issueDate      DateTime
  expiryDate     DateTime
  subtotal       Float
  taxTotal       Float
  total          Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items          CrmEstimateItem[]

  @@index([workspaceId])
  @@index([customerId])
}

model CrmEstimateItem {
  id          String      @id @default(uuid())
  estimateId  String
  estimate    CrmEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  rate        Float
  taxPercent  Float       @default(0.0)
  total       Float

  @@index([estimateId])
}

model CrmProposal {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId      String?
  subject     String
  content     String       @db.Text
  status      String       @default("DRAFT")
  total       Float
  expiryDate  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
  @@index([customerId])
}

model CrmProject {
  id          String                 @id @default(uuid())
  workspaceId String
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CrmCustomer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String                 @default("NOT_STARTED")
  startDate   DateTime?
  deadline    DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  milestones  CrmProjectMilestone[]
  tasks       CrmProjectTask[]

  @@index([workspaceId])
  @@index([customerId])
}

model CrmProjectMilestone {
  id          String           @id @default(uuid())
  projectId   String
  project     CrmProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  tasks       CrmProjectTask[]

  @@index([projectId])
}

model CrmProjectTask {
  id          String               @id @default(uuid())
  projectId   String
  project     CrmProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   CrmProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String               @default("BACKLOG")
  priority    String               @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
  @@index([milestoneId])
}

model CrmContract {
  id            String      @id @default(uuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId    String
  customer      CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject       String
  contractValue Float
  startDate     DateTime
  endDate       DateTime?
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([workspaceId])
  @@index([customerId])
}

model CrmTicket {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department    String
  subject       String
  priority      String           @default("MEDIUM")
  status        String           @default("OPEN")
  customerName  String
  customerEmail String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  replies       CrmTicketReply[]

  @@index([workspaceId])
}

model CrmTicketReply {
  id          String    @id @default(uuid())
  ticketId    String
  ticket      CrmTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderName  String
  senderEmail String
  message     String    @db.Text
  isAdminReply Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([ticketId])
}

// -----------------------------------------------------------------------------
// MARKETING MODULE ADDITIONS
// -----------------------------------------------------------------------------

model MarketingSmtpServer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  host        String
  port        Int
  secure      Boolean   @default(true)
  username    String
  password    String
  fromEmail   String
  fromName    String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// =============================================================================
// PHASE 3 — EMAIL MARKETING ENGINE
// =============================================================================

model SubscriberList {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscribers Subscriber[]

  @@index([workspaceId])
}

model Subscriber {
  id           String         @id @default(uuid())
  listId       String
  list         SubscriberList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email        String
  firstName    String?
  lastName     String?
  phone        String?
  status       String         @default("SUBSCRIBED")   // SUBSCRIBED | UNSUBSCRIBED | BOUNCED | COMPLAINED
  country      String?
  city         String?
  timezone     String?
  ipAddress    String?
  customFields Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  events       CampaignEvent[]

  @@unique([listId, email])
  @@index([listId])
  @@index([status])
}

model CampaignEvent {
  id           String      @id @default(uuid())
  campaignId   String
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  type         String      // OPEN | CLICK | BOUNCE | UNSUBSCRIBE | COMPLAINT
  url          String?
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  createdAt    DateTime    @default(now())

  @@index([campaignId])
  @@index([subscriberId])
  @@index([type])
}

model SmsProvider {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        String    @default("SSL_WIRELESS")  // SSL_WIRELESS | TWILIO | VONAGE | CUSTOM
  apiKey      String
  apiSecret   String?
  fromNumber  String?
  baseUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// =============================================================================
// PHASE 3 — RECURRING BILLING & EXPENSES
// =============================================================================

model RecurringInvoice {
  id              String       @id @default(uuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId      String
  customer        CrmCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoicePrefix   String       @default("INV")
  period          String       @default("MONTHLY")  // DAILY | WEEKLY | MONTHLY | YEARLY
  cycleCount      Int          @default(0)
  maxCycles       Int?
  nextRunAt       DateTime
  lastRunAt       DateTime?
  currency        String       @default("USD")
  subtotal        Float
  taxTotal        Float
  total           Float
  items           Json         // Array of {description, quantity, rate, taxPercent}
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([nextRunAt])
}

model Expense {
  id          String      @id @default(uuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  category    String?
  amount      Float
  currency    String      @default("USD")
  date        DateTime
  note        String?
  receiptUrl  String?
  billable    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId])
}

model RecurringExpense {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  amount      Float
  currency    String    @default("USD")
  period      String    @default("MONTHLY")
  nextRunAt   DateTime
  lastRunAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([nextRunAt])
}

// =============================================================================
// PHASE 3 — ACTIVITY LOG & GOALS
// =============================================================================

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  action      String    // CREATED | UPDATED | DELETED | VIEWED | SENT
  entityType  String    // CrmCustomer | CrmInvoice | Campaign | ...
  entityId    String
  entityLabel String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType])
}

model CrmGoal {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  type         String    @default("REVENUE")  // REVENUE | LEADS | CALLS | TASKS
  targetValue  Float
  currentValue Float     @default(0)
  deadline     DateTime?
  color        String    @default("#7c3aed")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
}

// =============================================================================
// PHASE 3 — STAFF OPERATIONS
// =============================================================================

model StaffTask {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("TODO")      // TODO | IN_PROGRESS | DONE | CANCELLED
  priority    String    @default("MEDIUM")    // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  assigneeIds Json?                           // Array of userId strings
  isRecurring Boolean   @default(false)
  recurringPeriod String?
  nextRunAt   DateTime?
  linkedType  String?                         // CrmCustomer | CrmProject | CrmInvoice
  linkedId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model StaffReminder {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  message     String
  remindAt    DateTime
  notifyEmail Boolean   @default(true)
  notifyBuiltIn Boolean @default(true)
  isSent      Boolean   @default(false)
  linkedType  String?
  linkedId    String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([remindAt, isSent])
}

// =============================================================================
// PHASE 3 — KNOWLEDGE BASE & SURVEYS
// =============================================================================

model KbCategory {
  id          String      @id @default(uuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())

  articles    KbArticle[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model KbArticle {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  slug        String
  content     String     @db.Text
  views       Int        @default(0)
  helpful     Int        @default(0)
  notHelpful  Int        @default(0)
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Survey {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  slug        String
  isPublic    Boolean          @default(false)
  closedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model SurveyQuestion {
  id          String    @id @default(uuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question    String
  type        String    @default("TEXT")   // TEXT | MULTIPLE_CHOICE | RATING | YES_NO
  options     Json?     // For MULTIPLE_CHOICE: array of strings
  order       Int       @default(0)
  required    Boolean   @default(false)

  @@index([surveyId])
}

model SurveyResponse {
  id          String    @id @default(uuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentEmail String?
  answers     Json      // { questionId: answer }
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([surveyId])
}

// =============================================================================
// PHASE 3 — WEB-TO-LEAD FORMS
// =============================================================================

model CrmWebForm {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  fields      Json      // Array of {name, type, label, required}
  redirectUrl String?
  thankYouMsg String?
  isActive    Boolean   @default(true)
  submissions Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// =============================================================================
// PHASE 3 — COMPANY OPERATIONS
// =============================================================================

model NewsfeedPost {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  content     String    @db.Text
  attachments Json?     // Array of {url, name, type}
  visibility  String    @default("ALL")   // ALL | DEPARTMENT
  department  String?
  likesCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model CompanyEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  color       String    @default("#7c3aed")
  isPublic    Boolean   @default(true)
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([startAt])
}


