# ==============================================================================
# FLOWSUITE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- APP CONFIGURATION ---
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- DATABASE CONFIGURATION ---
# Recommended Managed PostgreSQL: Neon (neon.tech) / Supabase / AWS RDS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowsuite?schema=public"

# --- REDIS CONFIGURATION ---
REDIS_URL="redis://localhost:6379"

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET="flowsuite-ultra-secure-jwt-secret-key-2026"
JWT_REFRESH_SECRET="flowsuite-refresh-token-secret-key-2026"

# --- OBJECT STORAGE (AWS S3 / CLOUDFLARE R2) ---
STORAGE_ENGINE="S3" # S3 or R2
AWS_ACCESS_KEY_ID="your-aws-or-r2-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-or-r2-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="flowsuite-media-assets"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # For Cloudflare R2

# --- TOP 10 AI PROVIDER KEYS ---
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
ANTHROPIC_API_KEY="sk-ant-..."
XAI_GROK_API_KEY="xai-..."
MISTRAL_API_KEY="..."
DEEPSEEK_API_KEY="sk-..."
GROQ_LLAMA_API_KEY="gsk_..."
COHERE_API_KEY="..."
STABILITY_API_KEY="sk-..."
KLING_AI_API_KEY="..."
RUNWAY_API_KEY="..."

# --- NARA ROUTER AI GATEWAY ---
NARA_ROUTER_API_KEY="nr-..."
NARA_ROUTER_MODEL="meta-llama/llama-3-8b-instruct"

# --- BANGLADESHI PAYMENT GATEWAYS ---
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"
BKASH_USERNAME="your-bkash-merchant-username"
BKASH_PASSWORD="your-bkash-merchant-password"
BKASH_IS_SANDBOX=true

NAGAD_MERCHANT_ID="your-nagad-merchant-id"
NAGAD_PUBLIC_KEY="your-nagad-public-key"
NAGAD_PRIVATE_KEY="your-nagad-private-key"

ROCKET_MERCHANT_ID="your-rocket-merchant-id"
UPAY_MERCHANT_ID="your-upay-merchant-id"

# --- GLOBAL PAYMENT GATEWAYS ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."

# --- OMNICHANNEL SOCIAL MEDIA API KEYS ---
META_APP_ID="your-facebook-meta-app-id"
META_APP_SECRET="your-facebook-meta-app-secret"
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
X_TWITTER_API_KEY="your-x-api-key"
X_TWITTER_API_SECRET="your-x-api-secret"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
